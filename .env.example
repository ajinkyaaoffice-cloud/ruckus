# Server (set these in your host's dashboard, never in the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Public address of the deployed site, used in invite links and QR codes
PUBLIC_URL=https://ruckus.example.com
# Optional: where the SQLite fallback is kept when Supabase isn't set
# RUCKUS_DB=/data/ruckus.db

# Frontend build (only if the game server lives on a different domain from the site)
# VITE_WS_URL=wss://api.example.com/ws
